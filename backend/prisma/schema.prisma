generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model outlets {
  id           Int         @id @default(autoincrement())
  outlet_name  String      @db.VarChar(100)
  manager_name String      @db.VarChar(100)
  address      String
  city         String      @db.VarChar(100)
  state        String      @db.VarChar(100)
  country      String      @db.VarChar(100)
  postal_code  String?     @db.VarChar(10)
  latitude     Decimal     @db.Decimal(10, 7)
  longitude    Decimal     @db.Decimal(10, 7)
  is_active    Boolean?    @default(true)
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  updated_at   DateTime?   @default(now()) @db.Timestamp(6)
  sales        sales[]
  users        users[]
  inventory    inventory[]
  staff        staff[]
}

model sales {
  id                  Int       @id @default(autoincrement())
  outlet_id           Int
  sale_date           DateTime  @db.Date
  total_orders        Int
  customer_count      Int
  gross_revenue       Decimal   @db.Decimal(12, 2)
  operating_cost      Decimal   @db.Decimal(12, 2)
  net_profit          Decimal   @db.Decimal(12, 2)
  average_order_value Decimal   @db.Decimal(10, 2)
  payment_cash        Decimal   @db.Decimal(10, 2)
  payment_card        Decimal   @db.Decimal(10, 2)
  payment_upi         Decimal   @db.Decimal(10, 2)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  outlets             outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_outlet")
}

model users {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  password_hash String    @db.VarChar(255)
  role          String    @default("MANAGER") @db.VarChar(50)
  outlet_id     Int?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  outlets       outlets?  @relation(fields: [outlet_id], references: [id], onDelete: SetNull, map: "fk_user_outlet")
}

model inventory {
  id            Int       @id @default(autoincrement())
  outlet_id     Int
  item_name     String    @db.VarChar(100)
  category      String    @db.VarChar(50)
  current_stock Decimal   @db.Decimal(10, 2)
  min_threshold Decimal   @db.Decimal(10, 2)
  max_capacity  Decimal   @db.Decimal(10, 2)
  unit          String    @db.VarChar(20)
  unit_price    Decimal   @db.Decimal(10, 2)
  status        String    @default("In Stock") @db.VarChar(30)
  last_restocked DateTime? @db.Date
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  outlets       outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade, map: "fk_inventory_outlet")
}

model staff {
  id                 Int       @id @default(autoincrement())
  outlet_id          Int
  name               String    @db.VarChar(100)
  role               String    @db.VarChar(50)
  shift_type         String    @db.VarChar(30)
  hourly_rate        Decimal   @db.Decimal(8, 2)
  hours_worked       Decimal   @db.Decimal(8, 2)
  performance_rating Decimal   @db.Decimal(3, 2)
  status             String    @default("Active") @db.VarChar(30)
  email              String?   @db.VarChar(150)
  phone              String?   @db.VarChar(30)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
  outlets            outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade, map: "fk_staff_outlet")
}

