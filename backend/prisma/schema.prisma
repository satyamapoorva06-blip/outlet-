generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.sqlite"
}

model outlets {
  id           Int         @id @default(autoincrement())
  outlet_name  String
  manager_name String
  address      String
  city         String
  state        String
  country      String
  postal_code  String?
  latitude     Float
  longitude    Float
  is_active    Boolean?    @default(true)
  created_at   DateTime?   @default(now())
  updated_at   DateTime?   @default(now())
  sales        sales[]
  users        users[]
  inventory    inventory[]
  staff        staff[]
}

model sales {
  id                  Int       @id @default(autoincrement())
  outlet_id           Int
  sale_date           String
  total_orders        Int
  customer_count      Int
  gross_revenue       Float
  operating_cost      Float
  net_profit          Float
  average_order_value Float
  payment_cash        Float
  payment_card        Float
  payment_upi         Float
  created_at          DateTime? @default(now())
  outlets             outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}

model users {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password_hash String
  role          String    @default("MANAGER")
  outlet_id     Int?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())
  outlets       outlets?  @relation(fields: [outlet_id], references: [id], onDelete: SetNull)
}

model inventory {
  id             Int       @id @default(autoincrement())
  outlet_id      Int
  item_name      String
  category       String
  current_stock  Float
  min_threshold  Float
  max_capacity   Float
  unit           String
  unit_price     Float
  status         String    @default("In Stock")
  last_restocked String?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())
  outlets        outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}

model staff {
  id                 Int       @id @default(autoincrement())
  outlet_id          Int
  name               String
  role               String
  assigned_job       String    @default("General Operations")
  shift_type         String
  login_time         String    @default("08:00 AM")
  logoff_time        String    @default("04:30 PM")
  hourly_rate        Float
  hours_worked       Float
  performance_rating Float
  status             String    @default("Active")
  email              String?
  phone              String?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @default(now())
  outlets            outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}
