generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model outlets {
  id           Int       @id @default(autoincrement())
  outlet_name  String    @db.VarChar(100)
  manager_name String    @db.VarChar(100)
  address      String
  city         String    @db.VarChar(100)
  state        String    @db.VarChar(100)
  country      String    @db.VarChar(100)
  postal_code  String?   @db.VarChar(10)
  latitude     Decimal   @db.Decimal(10, 7)
  longitude    Decimal   @db.Decimal(10, 7)
  is_active    Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  sales           sales[]
  inventory_items inventory_items[]
}

model sales {
  id                  Int       @id @default(autoincrement())
  outlet_id           Int
  sale_date           DateTime  @db.Date
  total_orders        Int
  customer_count      Int
  gross_revenue       Decimal   @db.Decimal(12, 2)
  operating_cost      Decimal   @db.Decimal(12, 2)
  net_profit          Decimal   @db.Decimal(12, 2)
  average_order_value Decimal   @db.Decimal(10, 2)
  payment_cash        Decimal   @db.Decimal(10, 2)
  payment_card        Decimal   @db.Decimal(10, 2)
  payment_upi         Decimal   @db.Decimal(10, 2)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  outlets             outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_outlet")
}

model inventory_items {
  id            Int              @id @default(autoincrement())
  outlet_id     Int
  item_name     String           @db.VarChar(100)
  sku           String           @db.VarChar(50)
  category      String           @db.VarChar(50)
  current_stock Decimal          @db.Decimal(10, 2)
  max_capacity  Decimal          @db.Decimal(10, 2)
  unit          String           @db.VarChar(20)
  min_threshold Decimal          @db.Decimal(10, 2)
  unit_cost     Decimal          @db.Decimal(10, 2)
  burn_rate     Decimal          @default(1.0) @db.Decimal(10, 2)
  auto_reorder  Boolean          @default(true)
  updated_at    DateTime?        @default(now()) @db.Timestamp(6)
  outlets       outlets          @relation(fields: [outlet_id], references: [id], onDelete: Cascade, map: "fk_inventory_outlet")
  logs          inventory_logs[]
}

model inventory_logs {
  id              Int             @id @default(autoincrement())
  item_id         Int
  action_type     String          @db.VarChar(50)
  quantity_change Decimal         @db.Decimal(10, 2)
  triggered_by    String          @db.VarChar(50)
  notes           String?
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  inventory_items inventory_items @relation(fields: [item_id], references: [id], onDelete: Cascade, map: "fk_inventory_log_item")
}
